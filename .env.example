# Copy to .env and fill in. .env is gitignored.

# --- transcription backend: elevenlabs | groq | local ---
DICTATE_BACKEND=elevenlabs

# ElevenLabs Scribe — most accurate on English, $0.22/hr of audio
ELEVENLABS_API_KEY=
DICTATE_EL_MODEL=scribe_v2

# Groq Whisper — ~5x cheaper and faster, a bit less accurate. Only used if BACKEND=groq
GROQ_API_KEY=
DICTATE_GROQ_MODEL=whisper-large-v3-turbo

# Offline fallback (needs: pip install -r requirements-local.txt). Slow on CPU.
DICTATE_LOCAL_MODEL=small

# --- LLM cleanup: punctuation, filler removal, paragraphs ---
DICTATE_CLEANUP=1
DICTATE_CLEANUP_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- general ---
# Empty = auto-detect. Set to en to lock it: slightly faster and more accurate.
DICTATE_LANGUAGE=en

# type = xdotool keystrokes (works everywhere) | clipboard = xclip + ctrl+v (faster, needs xclip)
DICTATE_INJECT=type

DICTATE_SOUNDS=1
DICTATE_TIMEOUT=60
